/*
  # ========================
  # SEGURIDAD - HARDENING
  # ========================

  # HSTS - Forzar HTTPS por 1 año (incluye subdominios y preload)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # X-Frame-Options - Prevenir clickjacking (ataques de interfaz)
  X-Frame-Options: DENY

  # X-Content-Type-Options - Prevenir MIME sniffing
  X-Content-Type-Options: nosniff

  # X-XSS-Protection - Proteger contra XSS (Cross-Site Scripting)
  X-XSS-Protection: 1; mode=block

  # Referrer-Policy - Controlar información del referer
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions-Policy - Limitar APIs sensibles del navegador
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), battery=(), vibrate=()

  # ========================
  # CONTENT SECURITY POLICY (CSP)
  # ========================
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://code.jquery.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

  # ========================
  # CORS - CONTROL DE ACCESO (SOLO ORÍGENES PERMITIDOS)
  # ========================
  Access-Control-Allow-Origin: https://falconmx1.github.io
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
  Access-Control-Allow-Credentials: true
  Access-Control-Max-Age: 86400

  # ========================
  # RENDIMIENTO Y CACHÉ
  # ========================
  Cache-Control: public, max-age=3600, must-revalidate
  Vary: Accept-Encoding
  X-Robots-Tag: index, follow
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# ================================================================
# CACHÉ ESPECÍFICO PARA ARCHIVOS ESTÁTICOS (1 AÑO)
# ================================================================

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

/*.eot
  Cache-Control: public, max-age=31536000, immutable

/*.json
  Cache-Control: public, max-age=86400, must-revalidate

/*.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/*.xml
  Cache-Control: public, max-age=3600, must-revalidate

# ================================================================
# CABECERAS ESPECÍFICAS PARA PÁGINAS CRÍTICAS
# ================================================================

/index.html
  Cache-Control: public, max-age=300, must-revalidate

/404.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ================================================================
# ARCHIVOS DE CONFIGURACIÓN - NO CACHEAR
# ================================================================

/*.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/robots.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sitemap.xml
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ================================================================
# FIN DEL ARCHIVO
