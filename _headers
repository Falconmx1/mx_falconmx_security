/*
  # ========================
  # SEGURIDAD - HARDENING
  # ========================

  # HSTS - Forzar HTTPS por 1 año (incluye subdominios y preload)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # X-Frame-Options - Prevenir clickjacking (ataques de interfaz)
  X-Frame-Options: DENY

  # X-Content-Type-Options - Prevenir MIME sniffing (evita ejecución de archivos maliciosos)
  X-Content-Type-Options: nosniff

  # X-XSS-Protection - Proteger contra XSS (Cross-Site Scripting)
  X-XSS-Protection: 1; mode=block

  # Referrer-Policy - Controlar información del referer (protege privacidad)
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions-Policy - Limitar APIs sensibles del navegador
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), battery=(), vibrate=()

  # ========================
  # CONTENT SECURITY POLICY (CSP)
  # ========================
  # Política de seguridad de contenido - Protege contra inyección de código
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://code.jquery.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

  # ========================
  # RENDIMIENTO Y CACHÉ
  # ========================

  # Cache-Control - Control de caché (1 hora para HTML, revalidación obligatoria)
  Cache-Control: public, max-age=3600, must-revalidate

  # Vary - Negociación de contenido (compresión, idioma, etc.)
  Vary: Accept-Encoding

  # X-Robots-Tag - Control de indexación por buscadores
  X-Robots-Tag: index, follow

  # Cross-Origin-Opener-Policy - Aislamiento de ventanas (seguridad)
  Cross-Origin-Opener-Policy: same-origin

  # Cross-Origin-Resource-Policy - Control de recursos compartidos
  Cross-Origin-Resource-Policy: same-origin


# ================================================================
# CACHÉ ESPECÍFICO PARA ARCHIVOS ESTÁTICOS (1 AÑO)
# ================================================================

# CSS - Hojas de estilo
/*.css
  Cache-Control: public, max-age=31536000, immutable

# JavaScript
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Imágenes PNG
/*.png
  Cache-Control: public, max-age=31536000, immutable

# Imágenes JPG
/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

# Imágenes SVG
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Iconos
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# WebP
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# GIF
/*.gif
  Cache-Control: public, max-age=31536000, immutable

# Fuentes
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

/*.eot
  Cache-Control: public, max-age=31536000, immutable

# Archivos JSON (ej: configuraciones, manifest)
/*.json
  Cache-Control: public, max-age=86400, must-revalidate

# Manifiesto de aplicación web
/*.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

# XML (ej: sitemap)
/*.xml
  Cache-Control: public, max-age=3600, must-revalidate

# ================================================================
# CABECERAS ESPECÍFICAS PARA PÁGINAS CRÍTICAS
# ================================================================

# Página principal - caché más corto (siempre actualizada)
/index.html
  Cache-Control: public, max-age=300, must-revalidate

# 404 - No cachear
/404.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ================================================================
# ARCHIVOS DE CONFIGURACIÓN - NO CACHEAR
# ================================================================

/*.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/robots.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sitemap.xml
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ================================================================
# FIN DEL ARCHIVO
